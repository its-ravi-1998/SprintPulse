{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "sprintpulse/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "sprintpulse/wsgi.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "sprintpulse/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "sprintpulse/wsgi.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
